<?xml version="1.0"?>
<!--
  SO-101 팔 (5축 + 집게) — **kinematics.py의 규약을 URDF로 옮긴 것**.

  이 파일의 유일한 책임: 관절이 전부 0일 때 팔이 **앞으로 수평하게 쭉 뻗은**
  자세가 되고, tool0의 위치가 kinematics.forward()와 mm 단위로 일치하는 것.
  (ros2/tools/ros_selfcheck.py가 이 일치를 실제로 검사한다.)

  축 규약이 왜 이렇게 생겼나 —
    · shoulder_pan  axis="0 0 1"  : 위에서 봤을 때 + = 반시계 (표준)
    · lift/elbow/wrist_flex axis="0 -1 0"
        -y 축 회전은 x를 +z 쪽으로 든다. kinematics.py의 "+ = 위로"가 그 뜻이다.
        (+y로 하면 부호가 통째로 뒤집혀 팔이 바닥을 판다. 이 한 줄이 전부다.)
    · wrist_roll    axis="1 0 0"  : 집게 축 자체. + = 뒤에서 봤을 때 반시계

  링크 길이는 관절 origin에 들어간다 — 중간에 fixed 조인트를 끼우지 않는 이유는
  TF 트리에 이름만 늘고 계산은 같기 때문이다. FK 식과 URDF를 나란히 놓고 읽을 수
  있는 쪽이 낫다.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="so101_arm" params="
      prefix parent
      xyz rpy
      z0 d0 l1 l2 l3
      pan_min pan_max lift_min lift_max elbow_min elbow_max
      wflex_min wflex_max wroll_min wroll_max grip_min grip_max">

    <!-- 관절 힘은 실측한 적이 없다. 여기 값은 **자리표시자**이며 IK/TF에는
         쓰이지 않는다(velocity/effort는 컨트롤러가 볼 때만 의미가 있다). -->
    <xacro:property name="eff" value="10.0"/>
    <xacro:property name="vel" value="3.0"/>
    <xacro:property name="rod_r" value="0.018"/>

    <!-- 관성은 시각화·TF에 쓰이지 않지만, URDF 검사기와 나중의 MoveIt/Gazebo가
         요구한다. 실측이 아니라 "말이 되는 값"이라는 걸 분명히 해 둔다. -->
    <xacro:macro name="dummy_inertial" params="m">
      <inertial>
        <mass value="${m}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
    </xacro:macro>

    <!-- 길이 rod_len짜리 막대를 로컬 +x 방향으로 그린다.
         ⚠ 인자 이름을 `len`으로 두면 안 된다 — xacro의 내장 심볼을 덮어써서
            `warning: redefining global symbol: len`을 stderr로 뱉는다. 그 자체는
            무해해 보이지만 런치의 Command 치환이 **stderr 한 줄을 곧 실패로**
            취급해서 로봇 기술 전체가 안 뜬다(실측: /robot_description 없음,
            TF 트리 없음, 링크 0개). 증상이 원인을 전혀 안 가리킨다. -->
    <xacro:macro name="rod_visual" params="rod_len mname rgba">
      <visual>
        <origin xyz="${rod_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${rod_r}" length="${rod_len}"/></geometry>
        <material name="${prefix}m_${mname}"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <origin xyz="${rod_len/2} 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="${rod_r}" length="${rod_len}"/></geometry>
      </collision>
    </xacro:macro>

    <!-- ============ 팔이 앉는 자리 ============ -->
    <link name="${prefix}arm_base">
      <visual>
        <origin xyz="0 0 0.012"/>
        <geometry><box size="0.07 0.07 0.024"/></geometry>
        <material name="${prefix}m_base"><color rgba="0.25 0.25 0.28 1"/></material>
      </visual>
      <xacro:dummy_inertial m="0.3"/>
    </link>
    <joint name="${prefix}arm_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}arm_base"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- ============ 1. shoulder_pan ============ -->
    <link name="${prefix}pan_link">
      <visual>
        <origin xyz="0 0 ${z0/2}"/>
        <geometry><cylinder radius="0.026" length="${z0}"/></geometry>
        <material name="${prefix}m_pan"><color rgba="0.85 0.25 0.2 1"/></material>
      </visual>
      <xacro:dummy_inertial m="0.2"/>
    </link>
    <joint name="${prefix}shoulder_pan" type="revolute">
      <parent link="${prefix}arm_base"/>
      <child link="${prefix}pan_link"/>
      <origin xyz="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${pan_min}" upper="${pan_max}" effort="${eff}" velocity="${vel}"/>
    </joint>

    <!-- ============ 2. shoulder_lift ============ -->
    <link name="${prefix}upper_arm_link">
      <xacro:rod_visual rod_len="${l1}" mname="upper" rgba="0.9 0.45 0.2 1"/>
      <xacro:dummy_inertial m="0.2"/>
    </link>
    <joint name="${prefix}shoulder_lift" type="revolute">
      <parent link="${prefix}pan_link"/>
      <child link="${prefix}upper_arm_link"/>
      <origin xyz="${d0} 0 ${z0}"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${lift_min}" upper="${lift_max}" effort="${eff}" velocity="${vel}"/>
    </joint>

    <!-- ============ 3. elbow_flex ============ -->
    <link name="${prefix}forearm_link">
      <xacro:rod_visual rod_len="${l2}" mname="fore" rgba="0.95 0.7 0.25 1"/>
      <xacro:dummy_inertial m="0.15"/>
    </link>
    <joint name="${prefix}elbow_flex" type="revolute">
      <parent link="${prefix}upper_arm_link"/>
      <child link="${prefix}forearm_link"/>
      <origin xyz="${l1} 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${elbow_min}" upper="${elbow_max}" effort="${eff}" velocity="${vel}"/>
    </joint>

    <!-- ============ 4. wrist_flex ============ -->
    <link name="${prefix}wrist_link">
      <visual>
        <origin xyz="0 0 0"/>
        <geometry><sphere radius="0.02"/></geometry>
        <material name="${prefix}m_wrist"><color rgba="0.4 0.6 0.9 1"/></material>
      </visual>
      <xacro:dummy_inertial m="0.08"/>
    </link>
    <joint name="${prefix}wrist_flex" type="revolute">
      <parent link="${prefix}forearm_link"/>
      <child link="${prefix}wrist_link"/>
      <origin xyz="${l2} 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${wflex_min}" upper="${wflex_max}" effort="${eff}" velocity="${vel}"/>
    </joint>

    <!-- ============ 5. wrist_roll ============ -->
    <link name="${prefix}gripper_link">
      <xacro:rod_visual rod_len="${l3}" mname="grip" rgba="0.55 0.75 0.4 1"/>
      <xacro:dummy_inertial m="0.1"/>
    </link>
    <joint name="${prefix}wrist_roll" type="revolute">
      <parent link="${prefix}wrist_link"/>
      <child link="${prefix}gripper_link"/>
      <origin xyz="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${wroll_min}" upper="${wroll_max}" effort="${eff}" velocity="${vel}"/>
    </joint>

    <!-- ============ TCP — **무는 지점**이다 ============
         집게 손끝이 아니라 물건을 무는 곳. kinematics.py의 l3가 여기까지의 길이다.
         이 점이 틀리면 IK가 푼 자세는 맞는데 집게가 열매를 스쳐 지나간다. -->
    <link name="${prefix}tool0">
      <xacro:dummy_inertial m="0.001"/>
    </link>
    <joint name="${prefix}tool0_fixed" type="fixed">
      <parent link="${prefix}gripper_link"/>
      <child link="${prefix}tool0"/>
      <origin xyz="${l3} 0 0"/>
    </joint>

    <!-- ============ 집게 (한 손가락만 관절로) ============
         두 손가락을 대칭으로 모델링하려면 mimic이 필요한데, 지금은 집게 상태를
         **보여 주기만** 하면 되므로 하나로 둔다. 열고 닫는 실제 지령은
         cartesian.set_grip()이 하고, 이 관절은 그 값을 되비추는 표시다. -->
    <link name="${prefix}finger_link">
      <visual>
        <origin xyz="0.015 0 0"/>
        <geometry><box size="0.03 0.006 0.02"/></geometry>
        <material name="${prefix}m_finger"><color rgba="0.3 0.3 0.3 1"/></material>
      </visual>
      <xacro:dummy_inertial m="0.01"/>
    </link>
    <joint name="${prefix}gripper" type="revolute">
      <parent link="${prefix}gripper_link"/>
      <child link="${prefix}finger_link"/>
      <origin xyz="${l3 - 0.03} 0 0.012"/>
      <axis xyz="0 -1 0"/>
      <limit lower="${grip_min}" upper="${grip_max}" effort="${eff}" velocity="${vel}"/>
    </joint>

  </xacro:macro>
</robot>
