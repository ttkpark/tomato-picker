[Unit]
Description=Tomato-picker voice command (arm + mecanum base, on-device STT)
After=network.target sound.target
# ⚠ 이쪽과 click-server는 **포트 8090과 팔 포트(/dev/ttyACM0)를 둘 다** 놓고 다툰다.
#   둘 다 enabled였던 탓에 부팅 한 번에 bind 실패로 2425번 되살아났다(09-18 실측,
#   `journalctl -u tomato-voice -b | grep -c 'Address already in use'`).
#   Conflicts는 systemd가 **먼저 상대를 내리고** 이쪽을 띄우게 한다 — 그래서
#   `systemctl start tomato-voice`가 이제 실제로 뜬다(예전엔 조용히 실패했다).
#   ⚠ 부팅 자동실행은 click-server 하나뿐이다(이쪽은 `systemctl disable`) —
#     둘 다 enabled면 부팅 순서에 따라 이긴 쪽이 바뀌어 매번 달라진다.
Conflicts=click-server.service
# bind 실패처럼 다시 해도 안 되는 이유로 죽으면 60초에 5번만 해 보고 포기한다.
# 아래 Restart=always를 남겨 둔 것은 장비 부재·USB 재열거에서는 여전히
# 되살아나야 하기 때문이다 — 막고 싶은 것은 '영원히 같은 실패'뿐이다.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=server
Group=server
# 마이크(audio)와 팔/베이스 시리얼(dialout) 접근에 둘 다 필요
SupplementaryGroups=audio dialout
# 대시보드를 80번에서도 열어주기 위해(→8090 리다이렉트). 비특권 유저라
# 이게 없으면 80 바인드가 거부되는데, 그래도 8090은 정상 동작한다.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# main.py가 `from src.tomato_picker...`로 임포트하므로 레포 루트가 cwd여야 함
WorkingDirectory=/home/server/tomato-picker
# 장비가 하나도 안 붙어 있어도 프로세스는 살아서 대시보드를 서빙한다
# (voice_mode.run_voice가 팔/바퀴/카메라/마이크 실패를 각각 흡수) —
# 예전엔 팔 없으면 exit해서 3초마다 재시작만 반복하고 화면이 안 떴다.
ExecStart=/home/server/lerobot/.venv/bin/python -u /home/server/tomato-picker/main.py voice
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
