[Unit]
Description=Floor CSI camera (IMX219) -> /dev/shm/line_cam.jpg (dashboard + line-following)
# Argus 데몬이 먼저 떠 있어야 세션이 열린다. 데몬이 재시작되면 같이 따라 재시작.
After=nvargus-daemon.service
Requires=nvargus-daemon.service

[Service]
Type=simple
User=server
Group=server
SupplementaryGroups=video
# 장착 방향 보정: 0=그대로, 2=180도(거꾸로 달았을 때). nvvidconv flip-method 값.
# 카메라는 전면 우측 바퀴 앞 바닥을 본다(라인트레이싱용) — 2026-08-09 장착.
Environment=FLIP=0
# 사전 조건: jetson-io로 "Camera IMX219 Dual" 오버레이 활성화(적용됨 2026-08-09).
# multifilesink가 같은 경로를 프레임마다 덮어쓴다(스냅샷 패턴). tmpfs라 SD 수명 무관.
# ⚠ 원자적 쓰기가 아니라 대시보드가 아주 드물게 찢어진 JPEG 한 프레임을 볼 수 있다
# — 라인 검출 파이썬 프로세스로 승격할 때 원자적 쓰기로 바꾼다.
ExecStart=/bin/sh -c 'exec gst-launch-1.0 -q nvarguscamerasrc sensor_id=0 ! "video/x-raw(memory:NVMM),width=1280,height=720,framerate=30/1" ! nvvidconv flip-method=${FLIP} ! nvjpegenc quality=70 ! multifilesink location=/dev/shm/line_cam.jpg'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
