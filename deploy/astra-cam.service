[Unit]
Description=Tomato-picker Astra Pro depth publisher (OpenNI2 -> /dev/shm)
After=network.target

[Service]
Type=simple
User=server
Group=server
# Astra Pro의 깊이 장치는 UVC가 아니라 **벤더 전용 벌크 인터페이스**다.
# libusb로 직접 여니까 /dev/bus/usb 접근이 필요하고, 그 권한을 주는 게
# 56-orbbec-usb.rules(GROUP=video)다. video 그룹이 없으면 장치를 못 연다.
# plugdev는 컬러(UVC)를 켤 때(ASTRA_COLOR=1) 쓴다.
SupplementaryGroups=video plugdev
WorkingDirectory=/home/server
Environment=PYTHONUNBUFFERED=1
# Orbbec OpenNI2 드라이버 위치 — deploy/astra-install.sh 가 여기에 푼다.
# ⚠ 우분투 apt의 libopenni2로는 **장치가 하나도 안 잡힌다**(PS1080 드라이버가
#   PrimeSense VID 0x1d27만 찾는데 Orbbec은 0x2bc5다). 에러가 아니라 "0개"로
#   조용히 끝나므로, 이 경로가 틀리면 "카메라 고장"처럼 보인다.
Environment=ASTRA_ONI_HOME=/home/server/openni2
# ⚠ 640x480으로 고정한다. ini 기본값(640x400)으로 열면 매 프레임 144바이트가
#   모자라 전부 깨진다(Depth buffer is corrupt, 실측 2026-09-01).
Environment=ASTRA_WIDTH=640
Environment=ASTRA_HEIGHT=480
Environment=ASTRA_FPS=30
# /dev/shm에 내보내는 주기. 카메라는 30fps로 돌지만 열매는 도망가지 않는다.
Environment=ASTRA_PUBLISH_FPS=8
# ⚠ 컬러는 **꺼 둔다** — 같은 UVC 노드를 tomato-vision이 잡고 있고, 장치는
#   한 프로세스만 연다. 켜려면 tomato-vision을 먼저 내리거나 TV_CAMERA_DEV로
#   다른 카메라를 물려라. 어차피 Astra 컬러는 깊이와 정렬돼 있지 않아서
#   보정 클릭에는 못 쓴다(깊이 화면에서 클릭한다).
Environment=ASTRA_COLOR=0
# ⚠ 깊이가 이 시간 동안 전부 0이면 장치를 다시 연다(프로세스를 끝내고 systemd가
#   새로 띄운다). 60cm보다 가까운 것을 보면 LDP가 투광기를 끄는데 **그 상태가
#   스트림 수명 내내 유지되기** 때문이다 — 카메라를 좋은 거리로 돌려놔도 0%가
#   그대로다(실측). 0으로 두면 이 기능이 꺼진다.
Environment=ASTRA_ZERO_REOPEN_SEC=30
ExecStart=/home/server/.venvs/vision/bin/python /home/server/tomato-picker/tools/astra_cam.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
