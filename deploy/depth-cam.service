[Unit]
Description=Tomato-picker D405 depth publisher (RealSense -> /dev/shm)
After=network.target

[Service]
Type=simple
User=server
Group=server
# D405는 UVC 장치라 /dev/video* 접근에 video 그룹이 필요하다. plugdev는
# librealsense가 USB 디스크립터를 읽을 때 쓴다(둘 다 없으면 장치를 못 연다).
SupplementaryGroups=video plugdev
WorkingDirectory=/home/server
Environment=PYTHONUNBUFFERED=1
# 848x480이 D405 깊이의 기본 해상도다. 1280x720도 되지만 uint16 프레임이
# 1.8MB가 되고 정확도 이득은 없다(깊이는 같은 스테레오 쌍에서 나온다).
Environment=D405_WIDTH=848
Environment=D405_HEIGHT=480
Environment=D405_FPS=30
# /dev/shm에 내보내는 주기. 카메라는 30fps로 돌지만 열매는 도망가지 않는다.
Environment=D405_PUBLISH_FPS=8
# 공간·시간 필터 — 정지 장면의 깊이 잡음을 줄여 보정 표본의 질을 올린다.
Environment=D405_FILTERS=1
# 노출·게인 (2026-09-18). **켜 둔다** — 자동노출이 이 무대에서 제 몫을 못 한다.
# ⚠ D405는 센서가 하나라 이 값이 컬러와 깊이에 **같이** 걸린다. 같은 날 실측
#   (848x480@30, 조명 없는 무대. 젯슨 서비스 그대로 재시작해 meta.json에서 읽음):
#                        컬러평균  최댓값  깊이유효율  근거리비율
#     자동노출              7.6      48     0.093        -
#     165000us · 게인248   34.1     119     0.534      0.954
#   ① 컬러는 손잡이를 끝까지 올려도 평균 34가 한계다 — 7.6이 나오는 건 발행기
#      탓이 아니라 **무대가 정말 어둡기 때문**이다(조명을 켜야 한다).
#   ② 그런데 **깊이 유효율이 5.7배**가 된다. 손-눈 표본 채집·깊이 차분은 전부
#      여기에 매달려 있으므로, 컬러를 못 살려도 이 손잡이는 값을 한다.
# ⚠ 165ms 노출은 스트림을 ~6fps로 떨어뜨리고 **움직이는 것을 흐리게** 만든다.
#   팔·베이스를 움직이며 D405 컬러로 무엇을 보려면 이 두 줄을 지워라.
Environment=D405_EXPOSURE_US=165000
Environment=D405_GAIN=248
ExecStart=/home/server/.venvs/vision/bin/python /home/server/tomato-picker/tools/depth_cam.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
